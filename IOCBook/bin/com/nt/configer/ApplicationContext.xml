<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <context:annotation-config/>
    <context:component-scan base-package="com.nt"/>
    
    <!-- Author Bean -->
    <bean id="author" class="com.nt.sbscn.Author">
    <constructor-arg value="1001"/>
    <constructor-arg value="Smith"/>
    </bean>
    
    <!-- Book Bean -->
    <bean id="book1" class="com.nt.sbscn.Book">
    <constructor-arg value="1002"/>
    <constructor-arg value="Java"/>
    </bean>
     <bean id="book2" class="com.nt.sbscn.Book">
        <constructor-arg value="1004"/>
        <constructor-arg value="Joshua Bloch"/>
    </bean>

    <bean id="book3" class="com.nt.sbscn.Book">
        <constructor-arg value="1005"/>
        <constructor-arg value="GoF"/>
    </bean>
    
    <!-- Library bean -->
    <bean id="library" class="com.nt.sbscn.Library">
    <constructor-arg value="San Library"/>
    <constructor-arg>
      <list>
                <ref bean="book1"/>
                <ref bean="book2"/>
                <ref bean="book3"/>
       </list>
    </constructor-arg>
    </bean>
    <!-- Librarian -->
    <bean id="librarian" class="com.nt.sbscn.Librarian">
    <property name="employeeName" value="Miller"></property>
    </bean>
    </beans>